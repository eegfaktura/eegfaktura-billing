{
  "_comment": "Shared sanitiser cases for mail-html-policy.json (konzept-mail-texte-editierbar.md, section H). Identical copy in eegfaktura-backend and eegfaktura-billing; both test suites run every case. Sanitise 'input' as the body of a mail whose catalog has the inline placeholders eeg.name and eeg.email and the block placeholder eeg.contactBlock, where context.ownImageId is an image of this mail and context.foreignImageId is not. reject=true: the input is refused (400). Otherwise the output must contain every 'contains' string and none of the 'notContains' strings. The strings avoid serialiser details (self-closing tags, quoting of entities, spaces in style values).",
  "version": 1,
  "context": {
    "ownImageId": "3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d",
    "foreignImageId": "9b2d1e44-1c55-4b7e-8f00-aa11bb22cc33",
    "linkRel": "noopener noreferrer"
  },
  "cases": [
    {"name": "script element removed with content", "input": "<p>a</p><script>alert(1)</script>", "contains": ["<p>a</p>"], "notContains": ["script", "alert"]},
    {"name": "style element removed with content", "input": "<style>p{color:red}</style><p>a</p>", "contains": ["<p>a</p>"], "notContains": ["style", "color"]},
    {"name": "iframe removed", "input": "<p>a</p><iframe src=\"https://evil.example\"></iframe>", "notContains": ["iframe", "evil"]},
    {"name": "object and embed removed", "input": "<object data=\"x\"></object><embed src=\"x\"><p>a</p>", "contains": ["<p>a</p>"], "notContains": ["object", "embed"]},
    {"name": "svg with script removed", "input": "<svg><script>alert(1)</script></svg><p>a</p>", "notContains": ["svg", "alert"]},
    {"name": "form and input removed", "input": "<form><input value=\"x\"></form><p>a</p>", "notContains": ["form", "input"]},
    {"name": "base element removed", "input": "<base href=\"https://evil.example/\"><p>a</p>", "notContains": ["base", "evil"]},
    {"name": "meta refresh removed", "input": "<meta http-equiv=\"refresh\" content=\"0;url=https://evil.example\"><p>a</p>", "notContains": ["meta", "evil"]},
    {"name": "link element removed", "input": "<link rel=\"stylesheet\" href=\"https://x.example/a.css\"><p>a</p>", "notContains": ["stylesheet", "a.css"]},
    {"name": "comment removed", "input": "<p>a<!-- secret --></p>", "contains": ["a"], "notContains": ["secret", "<!--"]},
    {"name": "onclick removed", "input": "<p onclick=\"alert(1)\">a</p>", "contains": ["a"], "notContains": ["onclick", "alert"]},
    {"name": "onerror on own image removed", "input": "<p>a</p><img src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\" onerror=\"alert(1)\">", "contains": ["mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d"], "notContains": ["onerror", "alert"]},
    {"name": "class and id removed", "input": "<p class=\"x\" id=\"y\">a</p>", "contains": ["a"], "notContains": ["class", "id="]},
    {"name": "javascript link removed, text kept", "input": "<p><a href=\"javascript:alert(1)\">x</a></p>", "contains": ["x"], "notContains": ["javascript", "href", "<a"]},
    {"name": "obfuscated javascript link removed", "input": "<p><a href=\"jav&#x09;ascript:alert(1)\">x</a></p>", "contains": ["x"], "notContains": ["ascript", "href"]},
    {"name": "data link removed", "input": "<p><a href=\"data:text/html;base64,PHNjcmlwdD4=\">x</a></p>", "contains": ["x"], "notContains": ["data:", "href"]},
    {"name": "http link removed", "input": "<p><a href=\"http://example.org\">x</a></p>", "contains": ["x"], "notContains": ["http:", "href"]},
    {"name": "protocol-relative link removed", "input": "<p><a href=\"//x.example/\">x</a></p>", "contains": ["x"], "notContains": ["href"]},
    {"name": "relative link removed", "input": "<p><a href=\"/relative\">x</a></p>", "contains": ["x"], "notContains": ["href"]},
    {"name": "https link without host removed", "input": "<p><a href=\"https:///x\">x</a></p>", "contains": ["x"], "notContains": ["href"]},
    {"name": "space inside URL removed", "input": "<p><a href=\"https://x.example/a b\">x</a></p>", "contains": ["x"], "notContains": ["href"]},
    {"name": "space in host removed", "input": "<p><a href=\"https://x .example/\">x</a></p>", "contains": ["x"], "notContains": ["href"]},
    {"name": "surrounding spaces of a URL trimmed", "input": "<p><a href=\" https://x.example/a \">x</a></p>", "contains": ["href=\"https://x.example/a\"", "rel=\"noopener noreferrer\""]},
    {"name": "https link kept with rel, target dropped", "input": "<p><a href=\"https://x.example/a?b=1\" target=\"_blank\" rel=\"opener\">x</a></p>", "contains": ["href=\"https://x.example/a?b=1\"", "rel=\"noopener noreferrer\""], "notContains": ["target", "opener\""]},
    {"name": "upper case https scheme kept", "input": "<p><a href=\"HTTPS://x.example/\">x</a></p>", "contains": ["x.example/", "rel=\"noopener noreferrer\""]},
    {"name": "https link with umlaut domain kept", "input": "<p><a href=\"https://www.eeg-öblarn.at/\">x</a></p>", "contains": ["href=\"https://www.eeg-öblarn.at/\"", "rel=\"noopener noreferrer\""]},
    {"name": "https link with | in the path kept", "input": "<p><a href=\"https://x.example/a|b\">x</a></p>", "contains": ["href=\"https://x.example/a|b\""]},
    {"name": "https link with % in the query kept", "input": "<p><a href=\"https://x.example/?q=50%25\">x</a></p>", "contains": ["href=\"https://x.example/?q=50%25\""]},
    {"name": "https link with {{ in the query kept", "input": "<p><a href=\"https://x.example/?t={{1}}\">x</a></p>", "contains": ["href=\"https://x.example/?t=", "rel=\"noopener noreferrer\""]},
    {"name": "mailto kept with rel", "input": "<p><a href=\"mailto:info@eeg.example\">mail</a></p>", "contains": ["href=\"mailto:info@eeg.example\"", "rel=\"noopener noreferrer\""]},
    {"name": "mailto without address removed", "input": "<p><a href=\"mailto:\">mail</a></p>", "contains": ["mail"], "notContains": ["href"]},
    {"name": "external image removed", "input": "<p>a</p><img src=\"https://tracker.example/p.png\">", "notContains": ["img", "tracker"]},
    {"name": "data image removed", "input": "<p>a</p><img src=\"data:image/png;base64,AAAA\">", "notContains": ["img", "data:"]},
    {"name": "foreign mailfile image removed", "input": "<p>a</p><img src=\"mailfile:9b2d1e44-1c55-4b7e-8f00-aa11bb22cc33\">", "notContains": ["img", "9b2d1e44"]},
    {"name": "mailfile with authority form removed", "input": "<p>a</p><img src=\"mailfile://3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\">", "notContains": ["img"]},
    {"name": "own image kept with alt and width, style dropped", "input": "<p>a</p><img src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\" alt=\"Logo\" width=\"200\" style=\"float:left\">", "contains": ["src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\"", "alt=\"Logo\"", "width=\"200\""], "notContains": ["float", "style"]},
    {"name": "upper case mailfile id normalised to lower case", "input": "<p>a</p><img src=\"MAILFILE:3F0C5A52-8F43-4C86-9A5E-3C0F7A1B2C3D\">", "contains": ["src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\""]},
    {"name": "image width in percent kept, other width removed", "input": "<p>a</p><img src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\" width=\"100%\"><img src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\" width=\"abc\">", "contains": ["width=\"100%\""], "notContains": ["abc"]},
    {"name": "built-in eegfaktura logo kept", "input": "<p>a</p><img src=\"mailfile:eegfaktura-logo\">", "contains": ["src=\"mailfile:eegfaktura-logo\""]},
    {"name": "text-align center kept on p", "input": "<p style=\"text-align:center\">a</p>", "contains": ["text-align", "center"]},
    {"name": "text-align kept on h1 h2 h3 li", "input": "<h1 style=\"text-align:right\">a</h1><h2 style=\"text-align:right\">b</h2><h3 style=\"text-align:right\">c</h3><ul><li style=\"text-align:right\">d</li></ul>", "contains": ["<h1 style=", "<h2 style=", "<h3 style=", "<li style=", "right"]},
    {"name": "text-align with empty declarations kept", "input": "<p style=\";text-align:center;;\">a</p>", "contains": ["text-align", "center"]},
    {"name": "upper case style property and value normalised", "input": "<p style=\"TEXT-ALIGN: CENTER\">a</p>", "contains": ["text-align", "center"], "notContains": ["CENTER"]},
    {"name": "other style declarations removed", "input": "<p style=\"color:red;text-align:right;font-size:30px\">a</p>", "contains": ["text-align", "right"], "notContains": ["color", "font-size"]},
    {"name": "text-align justify removed", "input": "<p style=\"text-align:justify\">a</p>", "contains": ["<p>a</p>"], "notContains": ["justify", "style"]},
    {"name": "style on an element without style removed", "input": "<blockquote style=\"text-align:center\">a</blockquote>", "contains": ["<blockquote>a</blockquote>"], "notContains": ["style"]},
    {"name": "font and table unwrapped, text kept", "input": "<p><font color=\"red\">a</font></p><table><tr><td>b</td></tr></table>", "contains": ["a", "b"], "notContains": ["font", "table", "td"]},
    {"name": "h4 unwrapped", "input": "<h4>a</h4>", "contains": ["a"], "notContains": ["h4"]},
    {"name": "escaped markup stays text", "input": "<p>&lt;script&gt;alert(1)&lt;/script&gt;</p>", "contains": ["&lt;script&gt;"], "notContains": ["<script"]},
    {"name": "inline placeholder kept", "input": "<p>Hallo <span data-ph=\"eeg.name\">x</span></p>", "contains": ["data-ph=\"eeg.name\""]},
    {"name": "content inside a placeholder replaced by its label", "input": "<p><span data-ph=\"eeg.name\"><script>alert(1)</script><b>EVIL</b><img src=\"https://t.example/x.gif\"></span></p>", "contains": ["data-ph=\"eeg.name\""], "notContains": ["EVIL", "alert", "<b>", "t.example"]},
    {"name": "other attributes of a placeholder removed", "input": "<p><span data-ph=\"eeg.email\" style=\"color:red\" onclick=\"x()\" class=\"ph\">x</span></p>", "contains": ["data-ph=\"eeg.email\""], "notContains": ["color", "onclick", "class"]},
    {"name": "block placeholder at top level kept", "input": "<div data-ph=\"eeg.contactBlock\">x</div>", "contains": ["data-ph=\"eeg.contactBlock\""]},
    {"name": "span and div without data-ph unwrapped", "input": "<div><p>a <span style=\"color:red\"><strong>b</strong></span> c</p></div>", "contains": ["<strong>b</strong>"], "notContains": ["<div", "<span", "color"]},
    {"name": "empty data-ph unwrapped", "input": "<p><span data-ph=\"\">x</span></p>", "contains": ["x"], "notContains": ["data-ph", "<span"]},
    {"name": "unknown placeholder rejected", "input": "<p><span data-ph=\"member.iban\">x</span></p>", "reject": true},
    {"name": "placeholder key is case sensitive", "input": "<p><span data-ph=\"EEG.NAME\">x</span></p>", "reject": true},
    {"name": "placeholder key with spaces rejected", "input": "<p><span data-ph=\" eeg.name \">x</span></p>", "reject": true},
    {"name": "block placeholder inside a paragraph rejected", "input": "<p>Gruß <span data-ph=\"eeg.contactBlock\">x</span></p>", "reject": true},
    {"name": "block placeholder inside a list rejected", "input": "<ul><li><div data-ph=\"eeg.contactBlock\">x</div></li></ul>", "reject": true},
    {"name": "empty after cleaning rejected", "input": "<script>x</script><p> </p><p><br></p>", "reject": true},
    {"name": "only an external image rejected as empty", "input": "<img src=\"https://x.example/a.png\">", "reject": true},
    {"name": "font-size 13px kept on p", "input": "<p style=\"font-size:13px\">a</p>", "contains": ["font-size", "13px"]},
    {"name": "font-size kept on h1 h2 h3 li", "input": "<h1 style=\"font-size:20px\">a</h1><h2 style=\"font-size:20px\">b</h2><h3 style=\"font-size:13px\">c</h3><ul><li style=\"font-size:13px\">d</li></ul>", "contains": ["<h1 style=", "<h2 style=", "<h3 style=", "<li style=", "20px", "13px"]},
    {"name": "font-size combined with text-align kept", "input": "<p style=\"text-align:center;font-size:20px\">a</p>", "contains": ["text-align", "center", "font-size", "20px"]},
    {"name": "font-size combined with text-align in the editor form with spaces kept", "input": "<p style=\"text-align: center; font-size: 20px\">a</p>", "contains": ["text-align", "center", "font-size", "20px"]},
    {"name": "upper case font-size normalised", "input": "<p style=\"FONT-SIZE: 20PX\">a</p>", "contains": ["font-size", "20px"], "notContains": ["20PX"]},
    {"name": "font-size with other values removed", "input": "<p style=\"font-size:30px\">a</p><p style=\"font-size:1em\">b</p><p style=\"font-size:13pt\">c</p><p style=\"font-size:20\">d</p><p style=\"font-size:20px !important\">e</p>", "contains": ["<p>a</p>", "<p>b</p>", "<p>c</p>", "<p>d</p>", "<p>e</p>"], "notContains": ["font-size", "style", "30px", "1em", "13pt"]},
    {"name": "other font-size removed, text-align kept", "input": "<p style=\"text-align:right;font-size:12px\">a</p>", "contains": ["text-align", "right"], "notContains": ["font-size", "12px"]},
    {"name": "font-size on span and div removed", "input": "<p>a <span style=\"font-size:20px\">b</span> <span data-ph=\"eeg.name\" style=\"font-size:20px\">x</span></p><div style=\"font-size:20px\"><p>c</p></div><div data-ph=\"eeg.contactBlock\" style=\"font-size:13px\">x</div>", "contains": ["b", "c", "data-ph=\"eeg.name\"", "data-ph=\"eeg.contactBlock\""], "notContains": ["font-size", "style"]},
    {"name": "image widths 200 400 600 kept", "input": "<p>a</p><img src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\" width=\"200\"><img src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\" width=\"400\"><img src=\"mailfile:3f0c5a52-8f43-4c86-9a5e-3c0f7a1b2c3d\" width=\"600\">", "contains": ["width=\"200\"", "width=\"400\"", "width=\"600\""]}
  ]
}
